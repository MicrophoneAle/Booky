# Copy to server/.env and fill in real values.
# Never commit server/.env.

# Supabase (service role — server only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Clerk
CLERK_SECRET_KEY=sk_test_...

# Optional: POST /admin/reparse
ADMIN_SECRET=change-this-in-production

# Optional: OpenAI (installed; not required for parse/read)
OPENAI_API_KEY=sk-...

# Optional local overrides (see README)
# PORT=3000
# CLIENT_URL=http://localhost:5173
# CLERK_PUBLISHABLE_KEY=pk_test_...
# BOOKY_REPARSE_ON_BOOT=1
# BOOKY_TEXT_EXTRACTION_CONCURRENCY=4
# BOOKY_IMAGE_EXTRACTION_CONCURRENCY=2
